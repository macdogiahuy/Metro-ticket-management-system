ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=metro_ticket;Username=metro_user;Password=your-local-password
Redis__ConnectionString=

Jwt__Issuer=metro-api
Jwt__Audience=metro-web
# Required in Production; Development generates an ephemeral key when empty.
Jwt__SigningKey=

Frontend__AllowedOrigins=http://localhost:5173

Payment__Provider=MOMO_TEST
Payment__Endpoint=https://test-payment.momo.vn/v2/gateway/api/create
Payment__PartnerCode=
Payment__AccessKey=
Payment__SecretKey=
Payment__WebhookSecret=
Payment__IpnUrl=https://your-public-host/api/v1/webhooks/momo

# BE-09: stable 32+ byte base64 secret, stored outside Git. Never generate a new key per boot.
TicketQr__ActiveKeyId=
# Use a key id such as v1; this field must match ActiveKeyId.
TicketQr__Keys__v1=
TicketQr__WorkerEnabled=true

# BE-10 / UC18: SMTP delivery, never expose support OTP in HTTP or logs.
GateEmail__WorkerEnabled=true
GateEmail__Host=
GateEmail__Port=587
GateEmail__EnableSsl=true
GateEmail__From=
GateEmail__UserName=
GateEmail__Password=
# Persist ASP.NET Data Protection keys outside the web root; share them across instances.
GateEmail__KeyRingPath=

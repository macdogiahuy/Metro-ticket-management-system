{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Metro": "Information"
    }
  },
  "AllowedHosts": "*",
  "Hardening": {
    "SecurityHeadersEnabled": true,
    "RateLimiting": {
      "Enabled": true,
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "Paths": [ "/api/v1/auth/", "/api/v1/payments", "/api/v1/webhooks/" ]
    },
    "RequireAuditOnAdminWrites": true
  },
  "CatalogCache": {
    "Enabled": true,
    "KeyPrefix": "catalog:v1:",
    "LinesAndStationsTtlSeconds": 60,
    "JourneysTtlSeconds": 60,
    "ServiceStatusTtlSeconds": 20
  },
  "ObjectStorage": {
    "Bucket": "assets"
  }
}

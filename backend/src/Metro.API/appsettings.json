{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Metro": "Information"
    }
  },
  "AllowedHosts": "*",
  "CatalogCache": {
    "Enabled": true,
    "KeyPrefix": "catalog:v1:",
    "LinesAndStationsTtlSeconds": 60,
    "JourneysTtlSeconds": 60,
    "ServiceStatusTtlSeconds": 20
  },
  "ObjectStorage": {
    "Bucket": "assets"
  }
}

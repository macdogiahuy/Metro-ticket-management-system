{
  "info": {
    "name": "Metro BE-12 Account administration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "UC22/UC23 manual workflow. Set adminToken from a verified Admin login, and userId to a disposable verified target account. Send mutations individually; do not run the collection blindly. Role changes and locking invalidate all target sessions. Obtain fresh tokens after changes. No credentials or real passenger data are bundled."
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:5001" },
    { "key": "adminToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "search", "value": "" }
  ],
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }] },
  "item": [
    { "name": "Find verified accounts", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/accounts?search={{search}}&page=1&pageSize=20" } },
    { "name": "List supported roles", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/roles" } },
    { "name": "Assign inspector role", "request": { "method": "PUT", "url": "{{baseUrl}}/api/v1/admin/accounts/{{userId}}/roles", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"roles\": [\"StationStaff\"],\n  \"reason\": \"Assigned inspection duties in test environment\"\n}" } } },
    { "name": "Lock test account", "request": { "method": "PUT", "url": "{{baseUrl}}/api/v1/admin/accounts/{{userId}}/status", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"LOCKED\",\n  \"reason\": \"Administrative lock test\"\n}" } } },
    { "name": "Unlock test account", "request": { "method": "PUT", "url": "{{baseUrl}}/api/v1/admin/accounts/{{userId}}/status", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"ACTIVE\",\n  \"reason\": \"Administrative unlock test\"\n}" } } },
    { "name": "View masked passenger data with audit", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/passengers/{{userId}}?purpose=SUPPORT_CASE" } },
    { "name": "Correct identity and require eligibility review", "request": { "method": "PUT", "url": "{{baseUrl}}/api/v1/admin/passengers/{{userId}}", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Synthetic Passenger\",\n  \"birthDate\": \"2000-01-01\",\n  \"reason\": \"Correct identity in test environment\"\n}" } } }
  ]
}

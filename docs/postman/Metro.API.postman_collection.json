{
  "info": {
    "name": "Metro API smoke",
    "description": "BE-18B smoke collection for health and authentication. Runtime tokens stay in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5192"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "",
      "type": "secret"
    },
    {
      "key": "verificationCode",
      "value": "",
      "type": "secret"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "secret"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "secret"
    },
    {
      "key": "lineId",
      "value": ""
    },
    {
      "key": "originStationId",
      "value": ""
    },
    {
      "key": "destinationStationId",
      "value": ""
    },
    {
      "key": "productCode",
      "value": "DEMO-SINGLE"
    },
    {
      "key": "adminAccessToken",
      "value": "",
      "type": "secret"
    },
    {
      "key": "adminProductId",
      "value": ""
    },
    {
      "key": "adminFareVersionId",
      "value": ""
    },
    {
      "key": "adminEligibilityPolicyId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health live",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health/live"
      }
    },
    {
      "name": "Register",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('email', `be18b-${Date.now()}@example.invalid`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('register returns 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('verificationCode', pm.response.json().devVerificationCode);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"fullName\": \"Postman Smoke Test\",\n  \"birthDate\": \"2000-01-01\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "Verify email",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('verification returns 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{verificationCode}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/verify-email"
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('accessToken', body.accessToken);",
              "pm.collectionVariables.set('refreshToken', body.refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Current account",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('authenticated account returns 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/me"
      }
    },
    {
      "name": "Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('logout returns 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/logout"
      }
    },
    {
      "name": "Catalog — List lines (UC07)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('lines returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('lines payload has array', () => pm.expect(body.lines).to.be.an('array'));",
              "if (body.lines.length > 0) {",
              "  const firstLine = body.lines[0];",
              "  pm.collectionVariables.set('lineId', firstLine.id);",
              "  if (firstLine.stops && firstLine.stops.length >= 2) {",
              "    pm.collectionVariables.set('originStationId', firstLine.stops[0].stationId);",
              "    pm.collectionVariables.set('destinationStationId', firstLine.stops[firstLine.stops.length - 1].stationId);",
              "  }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/lines"
      }
    },
    {
      "name": "Catalog — List stations by line (UC07)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('stations returns 200', () => pm.response.to.have.status(200));",
              "pm.test('stations payload has array', () => pm.expect(pm.response.json().stations).to.be.an('array'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/stations?lineId={{lineId}}"
      }
    },
    {
      "name": "Catalog — Stations unknown line returns 404 (UC07)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('unknown line returns 404', () => pm.response.to.have.status(404));",
              "pm.test('problem code is LINE_NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('LINE_NOT_FOUND'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/stations?lineId=00000000-0000-0000-0000-000000000000"
      }
    },
    {
      "name": "Catalog — Search journeys (UC08)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('journeys returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('at least one optimal route returned', () => pm.expect(body.options.length).to.be.above(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/journeys?originStationId={{originStationId}}&destinationStationId={{destinationStationId}}"
      }
    },
    {
      "name": "Catalog — Service status (UC10)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('service status returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('has overallStatus and dataAsOf', () => {",
              "  pm.expect(body.overallStatus).to.be.a('string');",
              "  pm.expect(body.dataAsOf).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/service-status?lineId={{lineId}}"
      }
    },
    {
      "name": "Fare — Quote single trip (UC09)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('fare quote returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('quote contains version and VND total', () => {",
              "  pm.expect(body.isReferenceQuote).to.eql(true);",
              "  pm.expect(body.currency).to.eql('VND');",
              "  pm.expect(body.farePolicy.id).to.be.a('string');",
              "  pm.expect(body.totalAmountMinor).to.be.a('number');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/fares/quote?productCode={{productCode}}&originStationId={{originStationId}}&destinationStationId={{destinationStationId}}&eligibilityGroup=ORDINARY"
      }
    },
    {
      "name": "Admin — List ticket products (UC25)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('list products returns 200', () => pm.response.to.have.status(200));",
              "const items = pm.response.json();",
              "if (items.length > 0) pm.collectionVariables.set('adminProductId', items[0].id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/admin/products"
      }
    },
    {
      "name": "Admin — Create ticket product (UC25)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('create product returns 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('adminProductId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccessToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "pm-create-day-{{$timestamp}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"DAY-PASS-{{$timestamp}}\",\n  \"name\": \"Ve ngay\",\n  \"productType\": \"DAY\",\n  \"durationValue\": 1,\n  \"durationUnit\": \"DAY\",\n  \"expiryRule\": \"NEXT_LOCAL_MIDNIGHT\",\n  \"requiresNamedHolder\": false,\n  \"capacityControlled\": false,\n  \"status\": \"ACTIVE\",\n  \"reason\": \"Create demo day pass\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/admin/products"
      }
    },
    {
      "name": "Admin — Create fare policy version (UC25)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('create fare version returns 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('adminFareVersionId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" },
          { "key": "Idempotency-Key", "value": "pm-create-fare-{{$timestamp}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"FARE-V-{{$timestamp}}\",\n  \"scopeKey\": \"DEMO-NETWORK\",\n  \"effectiveFrom\": \"2027-01-01T00:00:00Z\",\n  \"effectiveTo\": \"2027-12-31T23:59:59Z\",\n  \"reason\": \"Prepare 2027 fare schedule\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/admin/fares"
      }
    },
    {
      "name": "Admin — Add NULL-safe fare matrix entry (UC25)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" },
          { "key": "Idempotency-Key", "value": "pm-add-entry-{{$timestamp}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ticketProductId\": \"{{adminProductId}}\",\n  \"lineId\": null,\n  \"originStationId\": null,\n  \"destinationStationId\": null,\n  \"paymentChannel\": \"ANY\",\n  \"eligibilityGroup\": \"ORDINARY\",\n  \"amountMinor\": 30000,\n  \"sellable\": true,\n  \"reason\": \"Set base day fare\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/admin/fares/{{adminFareVersionId}}/entries"
      }
    },
    {
      "name": "Admin — Create eligibility policy (UC25)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('create eligibility policy returns 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('adminEligibilityPolicyId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminAccessToken}}" },
          { "key": "Idempotency-Key", "value": "pm-create-elig-{{$timestamp}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"ELDERLY-{{$timestamp}}\",\n  \"beneficiaryGroup\": \"ELDERLY\",\n  \"discountType\": \"PERCENT\",\n  \"discountValue\": 20,\n  \"eligibleProductCodes\": [],\n  \"requiredEvidenceTypes\": [\"CITIZEN_ID_DEMO\"],\n  \"effectiveFrom\": \"2027-01-01T00:00:00Z\",\n  \"effectiveTo\": null,\n  \"reason\": \"BR-071 20% elderly discount\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/admin/eligibility-policies"
      }
    }
  ]
}
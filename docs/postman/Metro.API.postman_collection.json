  "item": [
    {
      "name": "Reports — Admin (BE-15)",
      "description": "Set adminAccessToken from a seeded Admin account that has an ACTIVE operator_account. Reports infer the operator from that membership; they deliberately do not accept operatorCode.",
      "item": [
        {
          "name": "Revenue report",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/reports/revenue?from=2026-11-01&to=2026-11-30",
            "description": "UTC+7 inclusive dates, maximum 31 days. Payment totals use the payment's frozen order version."
          }
        },
        {
          "name": "Ticket issuance report",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/reports/tickets?from=2026-11-01&to=2026-11-30&page=1&pageSize=50",
            "description": "Issuance status comes from the BE-09 durable ticket_issuance_jobs queue."
          }
        },
        {
          "name": "Export revenue CSV",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/reports/revenue/export?from=2026-11-01&to=2026-11-30&purpose=Monthly%20reconciliation",
            "description": "Returns UTF-8 CSV and records REPORT_EXPORT audit data. purpose is required; never put personal data in it."
          }
        }
      ]
    },
    {
      "name": "Health live",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health/live"
      }
    },
    {
      "name": "Register",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('email', `be18b-${Date.now()}@example.invalid`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('register returns 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('verificationCode', pm.response.json().devVerificationCode);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"fullName\": \"Postman Smoke Test\",\n  \"birthDate\": \"2000-01-01\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "Verify email",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('verification returns 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{verificationCode}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/verify-email"
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('accessToken', body.accessToken);",
              "pm.collectionVariables.set('refreshToken', body.refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Current account",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('authenticated account returns 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/me"
      }
    },
    {
      "name": "Logout",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('logout returns 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/logout"
      }
    },
    {
      "name": "Catalog — List lines (UC07)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('lines returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('lines payload has array', () => pm.expect(body.lines).to.be.an('array'));",
              "if (body.lines.length > 0) {",
              "  const firstLine = body.lines[0];",
              "  pm.collectionVariables.set('lineId', firstLine.id);",
              "  if (firstLine.stops && firstLine.stops.length >= 2) {",
              "    pm.collectionVariables.set('originStationId', firstLine.stops[0].stationId);",
              "    pm.collectionVariables.set('destinationStationId', firstLine.stops[firstLine.stops.length - 1].stationId);",
              "  }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/lines"
      }
    },
    {
      "name": "Catalog — List stations by line (UC07)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('stations returns 200', () => pm.response.to.have.status(200));",
              "pm.test('stations payload has array', () => pm.expect(pm.response.json().stations).to.be.an('array'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/stations?lineId={{lineId}}"
      }
    },
    {
      "name": "Catalog — Stations unknown line returns 404 (UC07)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('unknown line returns 404', () => pm.response.to.have.status(404));",
              "pm.test('problem code is LINE_NOT_FOUND', () => pm.expect(pm.response.json().code).to.eql('LINE_NOT_FOUND'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/stations?lineId=00000000-0000-0000-0000-000000000000"
      }
    },
    {
      "name": "Catalog — Search journeys (UC08)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('journeys returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('at least one optimal route returned', () => pm.expect(body.options.length).to.be.above(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/journeys?originStationId={{originStationId}}&destinationStationId={{destinationStationId}}"
      }
    },
    {
      "name": "Catalog — Service status (UC10)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('service status returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('has overallStatus and dataAsOf', () => {",
              "  pm.expect(body.overallStatus).to.be.a('string');",
              "  pm.expect(body.dataAsOf).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/service-status?lineId={{lineId}}"
      }
    },
    {
      "name": "BE-09 Tickets and history",
      "item": [
        {
          "name": "My tickets",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/tickets?operatorCode={{operatorCode}}",
            "description": "Set operatorCode to the same active operator as catalog/checkout. History defaults to 30 calendar days and pageSize=20; optional fromDate/toDate YYYY-MM-DD. Ticket owner or current verified guardian only. QR is a private PNG; this GET never creates a credential."
          }
        },
        {
          "name": "Ticket details",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}?operatorCode={{operatorCode}}",
            "description": "Set operatorCode to the same active operator as catalog/checkout. History defaults to 30 calendar days and pageSize=20; optional fromDate/toDate YYYY-MM-DD. Ticket owner or current verified guardian only. QR is a private PNG; this GET never creates a credential."
          }
        },
        {
          "name": "Current QR PNG",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/qr?operatorCode={{operatorCode}}",
            "description": "Set operatorCode to the same active operator as catalog/checkout. History defaults to 30 calendar days and pageSize=20; optional fromDate/toDate YYYY-MM-DD. Ticket owner or current verified guardian only. QR is a private PNG; this GET never creates a credential."
          }
        },
        {
          "name": "My order history",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/orders?operatorCode={{operatorCode}}",
            "description": "Set operatorCode to the same active operator as catalog/checkout. History defaults to 30 calendar days and pageSize=20; optional fromDate/toDate YYYY-MM-DD. Ticket owner or current verified guardian only. QR is a private PNG; this GET never creates a credential."
          }
        },
        {
          "name": "My payment history",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/payments?operatorCode={{operatorCode}}",
            "description": "Set operatorCode to the same active operator as catalog/checkout. History defaults to 30 calendar days and pageSize=20; optional fromDate/toDate YYYY-MM-DD. Ticket owner or current verified guardian only. QR is a private PNG; this GET never creates a credential."
          }
        },
        {
          "name": "Confirm free child order",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.collectionVariables.get('ticketIssueKey')) pm.collectionVariables.set('ticketIssueKey', pm.variables.replaceIn('{{$guid}}'));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Confirmed or already issued', () => pm.expect([200,202]).to.include(pm.response.code));",
                  "if ([200,202].includes(pm.response.code)) { const r=pm.response.json(); if(r.ticketIds?.length) pm.collectionVariables.set('ticketId',r.ticketIds[0]); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/issue-free?operatorCode={{operatorCode}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{ticketIssueKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderVersion\": {{orderVersion}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Use the approved guardian JWT. Order must be confirmed, single-trip and zero-payable for a verified child younger than six on travel date, with a qualifying guardian ticket. Reuse key/version for retries; clear ticketIssueKey for a different order. No payment is created. 202 waits for the durable QR worker; poll My tickets."
          }
        }
      ]
    },
    {
      "name": "Fare — Quote single trip (UC09)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('fare quote returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('quote contains version and VND total', () => {",
              "  pm.expect(body.isReferenceQuote).to.eql(true);",
              "  pm.expect(body.currency).to.eql('VND');",
              "  pm.expect(body.farePolicy.id).to.be.a('string');",
              "  pm.expect(body.totalAmountMinor).to.be.a('number');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/fares/quote?productCode={{productCode}}&originStationId={{originStationId}}&destinationStationId={{destinationStationId}}&eligibilityGroup=ORDINARY"
      }
